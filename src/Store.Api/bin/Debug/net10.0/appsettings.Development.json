{
  "Seed": {
    "DemoCatalogue": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",

        // Set to "Information" to log every SQL statement with its execution time.
        // Invaluable for spotting N+1 patterns and unbounded reads, but extremely noisy —
        // leave it at Warning unless actively profiling.
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}

