{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WaqasProvisionStore;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=false;Encrypt=True"
  },

  "Jwt": {
    "Issuer": "WaqasProvisionStore",
    "Audience": "WaqasProvisionStore.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },

  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads"
  },

  "RateLimiting": {
    // Anonymous traffic is partitioned by IP, and a whole office, school or mobile-carrier NAT
    // shares one. A single shopper browsing briskly makes 30–60 requests a minute, so the original
    // 300 would have started rejecting real customers as soon as a handful of them sat behind the
    // same address — load testing surfaced exactly that.
    //
    // This is a backstop against runaway clients, not the primary DoS control; that belongs at
    // nginx or the CDN, which can see the traffic before it reaches the app.
    "GlobalPermitPerMinute": 1200,

    // Sign-in, registration, password reset and checkout stay tight. This is the anti-automation
    // control that complements Identity's per-account lockout, and it is per-IP on purpose.
    "AuthPermitPerMinute": 10
  },

  "Performance": {
    "SlowRequestThresholdMs": 300,
    "SlowQueryThresholdMs": 150
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
